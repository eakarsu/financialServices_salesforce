BACKEND_PORT=3001
NODE_ENV=development
DATABASE_URL=postgresql://postgres:local-password@127.0.0.1:5432/financial_services_salesforce
JWT_SECRET=generate-a-random-value-with-at-least-32-characters
OUTREACH_WEBHOOK_SECRET=generate-an-independent-random-value-with-at-least-32-characters
ALLOWED_ORIGINS=http://127.0.0.1:5173
# Connector secrets are supplied at runtime; the database stores only the reference.
# CONNECTOR_SECRET_ACME_SALESFORCE=replace-at-deployment-time
